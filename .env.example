# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app,localhost,127.0.0.1

# Database — Railway injects this automatically when you add a Postgres plugin.
# For local dev, leave unset to use SQLite.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Licensing — used to sign and verify product keys you generate.
LICENSE_SECRET_KEY=choose-a-long-random-secret-for-signing-keys

# Media — set USE_S3=true to store logos/photos on Cloudflare R2 or Supabase S3.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
MEDIA_URL=
